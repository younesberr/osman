# Copier ce fichier vers .env et remplir les valeurs. NE JAMAIS commiter .env.
PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=osmanexpress_app
DB_PASSWORD=changez-moi
DB_NAME=osmanexpress

# Générer avec: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origine du frontend (plusieurs valeurs séparées par des virgules)
CLIENT_ORIGIN=http://localhost:5173

# true = re-hash automatiquement les mots de passe MD5 legacy vers bcrypt au login.
# ATTENTION: à laisser sur false si une autre application (ex: ancien site PHP)
# utilise encore la même base avec des comparaisons MD5.
UPGRADE_LEGACY_HASHES=false
